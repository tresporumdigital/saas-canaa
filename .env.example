# Copie para .env.development.local para desenvolvimento local (não é commitado;
# ".local" já cai no .gitignore, e "development" garante que só vale para `npm run dev`,
# nunca para `npm run build`, que deve continuar usando o padrão relativo "/api").
#
# Em produção o app é servido do mesmo domínio da API, então "/api" já resolve
# sem precisar configurar nada (é o valor usado quando nenhuma env var é definida).
#
# Em dev local (`npm run dev`) não existe API rodando na sua máquina — aponte
# para a API de produção (mesmo banco, sem ambiente de homologação separado):
VITE_API_BASE_URL=https://backoffice.funerariacanaa.com/api
